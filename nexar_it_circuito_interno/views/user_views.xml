<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_users_internal_access" model="ir.ui.view">
        <field name="name">res.users.form.circuito.interno</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="inside">
                <group string="Circuito interno" groups="base.group_system">
                    <field name="ni_menu_enabled"/>
                    <div class="text-muted">Activar expresamente para cada usuario autorizado. El titular opera su circuito y los administradores habilitados acceden a su configuración.</div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
