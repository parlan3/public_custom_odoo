<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="menu_setup_root" model="ir.ui.menu">
    <field name="name">Circuito interno</field>
    <field name="sequence">95</field>
    <field name="group_ids" eval="[(6, 0, [ref('group_menu')])]" />
  </record>
  <record id="setup_view" model="ir.ui.view">
    <field name="name">nexar.internal.setup.form</field>
    <field name="model">nexar.internal.setup</field>
    <field name="arch" type="xml">
      <form string="Configurar circuito interno">
        <div class="alert alert-warning" role="alert">El titular tendrá acceso contable exclusivamente a este circuito. Se reemplazarán sus grupos y compañías. Ejecutar primero en el entorno de pruebas con una copia de respaldo.</div>
        <group>
          <field name="company_ids" widget="many2many_tags" options="{'no_create': True}" />
          <field name="user_id" options="{'no_create': True}" />
          <field name="acknowledge" />
          <field name="migrate_legacy" />
        </group>
        <footer>
          <button name="action_configure" type="object" string="Configurar circuito" class="btn-primary" />
          <button string="Cancelar" special="cancel" />
        </footer>
      </form>
    </field>
  </record>
  <record id="action_setup" model="ir.actions.act_window">
    <field name="name">Configurar circuito interno</field>
    <field name="res_model">nexar.internal.setup</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
  <menuitem id="menu_setup" name="Configurar circuito" parent="menu_setup_root" action="action_setup" groups="base.group_system" />
  <record id="move_form_internal" model="ir.ui.view">
    <field name="name">account.move.form.internal</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form" />
    <field name="arch" type="xml">
      <xpath expr="//sheet" position="inside">
        <field name="ni_circuit_id" invisible="True" />
        <div class="alert alert-warning" role="alert" invisible="not ni_circuit_id">CIRCUITO INTERNO — SIN EMISIÓN ARCA</div>
      </xpath>
    </field>
  </record>
  <record id="action_sales" model="ir.actions.act_window">
    <field name="name">Ventas internas</field>
    <field name="res_model">account.move</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('move_type', 'in', ['out_invoice', 'out_refund']), ('ni_circuit_id', '!=', False)]</field>
    <field name="context">{'default_move_type': 'out_invoice'}</field>
  </record>
  <menuitem id="menu_sales" name="Ventas internas" parent="menu_setup_root" action="action_sales" groups="group_operator" sequence="10" />
  <record id="action_purchases" model="ir.actions.act_window">
    <field name="name">Compras internas</field>
    <field name="res_model">account.move</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('move_type', 'in', ['in_invoice', 'in_refund']), ('ni_circuit_id', '!=', False)]</field>
    <field name="context">{'default_move_type': 'in_invoice'}</field>
  </record>
  <menuitem id="menu_purchases" name="Compras internas" parent="menu_setup_root" action="action_purchases" groups="group_operator" sequence="10" />
  <record id="action_payments" model="ir.actions.act_window">
    <field name="name">Cobros y pagos internos</field>
    <field name="res_model">account.payment</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('ni_circuit_id', '!=', False)]</field>
    <field name="context">{}</field>
  </record>
  <menuitem id="menu_payments" name="Cobros y pagos internos" parent="menu_setup_root" action="action_payments" groups="group_operator" sequence="10" />
  <record id="action_entries" model="ir.actions.act_window">
    <field name="name">Asientos internos</field>
    <field name="res_model">account.move</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('ni_circuit_id', '!=', False)]</field>
    <field name="context">{'default_move_type': 'entry'}</field>
  </record>
  <menuitem id="menu_entries" name="Asientos internos" parent="menu_setup_root" action="action_entries" groups="group_operator" sequence="10" />
</odoo>