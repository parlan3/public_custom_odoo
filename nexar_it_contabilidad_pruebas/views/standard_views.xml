        <field name="tag">account_report</field>
        <field name="context">{'cdp_report_scope': 'both'}</field>
        <field name="params" eval="{'report_id': ref('account_reports.balance_sheet')}" />
    </record>
    <menuitem id="menu_balance_sheet_both" name="Balance combinado" parent="menu_root" action="balance_sheet_both" sequence="50" />
    <record id="profit_and_loss_cdp" model="ir.actions.client">
