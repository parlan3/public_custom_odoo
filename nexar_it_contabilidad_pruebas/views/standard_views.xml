        <field name="tag">account_report</field>
        <field name="context">{'cdp_report_scope': 'cdp'}</field>
        <field name="params" eval="{'report_id': ref('account_reports.profit_and_loss')}" />
    </record>
    <menuitem id="menu_profit_and_loss_cdp" name="Resultados CDP" parent="menu_root" action="profit_and_loss_cdp" sequence="50" />
    <record id="profit_and_loss_fiscal" model="ir.actions.client">
        <field name="name">Resultados fiscal</field>
        <field name="tag">account_report</field>
        <field name="context">{'cdp_report_scope': 'fiscal'}</field>
        <field name="params" eval="{'report_id': ref('account_reports.profit_and_loss')}" />
    </record>
    <menuitem id="menu_profit_and_loss_fiscal" name="Resultados fiscal" parent="menu_root" action="profit_and_loss_fiscal" sequence="50" />
    <record id="profit_and_loss_both" model="ir.actions.client">
        <field name="name">Resultados combinado</field>
        <field name="tag">account_report</field>
        <field name="context">{'cdp_report_scope': 'both'}</field>
        <field name="params" eval="{'report_id': ref('account_reports.profit_and_loss')}" />
    </record>
    <menuitem id="menu_profit_and_loss_both" name="Resultados combinado" parent="menu_root" action="profit_and_loss_both" sequence="50" />
    <record id="cdp_items" model="ir.actions.act_window">
        <field name="name">Apuntes CDP</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="domain">[('cdp_circuit_id', '!=', False)]</field>
        <field name="context">{}</field>
    </record>
    <menuitem id="menu_cdp_items" name="Apuntes" parent="menu_root" action="cdp_items" sequence="35" />
    <template id="invoice_cdp_notice" inherit_id="account.report_invoice_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <div t-if="o.journal_id.cdp_circuit_id" class="mt-4 fw-bold">CDP — SIMULACIÓN SIN VALIDEZ FISCAL</div>
        </xpath>
    </template>
</odoo>