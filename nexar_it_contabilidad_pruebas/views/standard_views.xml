    </record>
    <menuitem id="menu_report_both" name="Mayor combinado" parent="menu_root" action="report_both" sequence="40" />
    <record id="balance_sheet_cdp" model="ir.actions.client">
        <field name="name">Balance CDP</field>
        <field name="tag">account_report</field>
        <field name="context">{'cdp_report_scope': 'cdp'}</field>
        <field name="params" eval="{'report_id': ref('account_reports.balance_sheet')}" />
    </record>
    <menuitem id="menu_balance_sheet_cdp" name="Balance CDP" parent="menu_root" action="balance_sheet_cdp" sequence="50" />
    <record id="balance_sheet_fiscal" model="ir.actions.client">
        <field name="name">Balance fiscal</field>
        <field name="tag">account_report</field>
        <field name="context">{'cdp_report_scope': 'fiscal'}</field>
        <field name="params" eval="{'report_id': ref('account_reports.balance_sheet')}" />
    </record>
    <menuitem id="menu_balance_sheet_fiscal" name="Balance fiscal" parent="menu_root" action="balance_sheet_fiscal" sequence="50" />
    <record id="balance_sheet_both" model="ir.actions.client">
