<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="group_access" model="res.groups">
    <field name="name">Consultar circuito restringido</field>
  </record>
  <record id="group_reader" model="res.groups">
    <field name="name">Circuito restringido solo consulta</field>
    <field name="implied_ids" eval="[(4, ref('group_access')), (4, ref('account.group_account_readonly'))]" />
  </record>
  <record id="group_operator" model="res.groups">
    <field name="name">Circuito restringido operación</field>
    <field name="implied_ids" eval="[(4, ref('group_access')), (4, ref('account.group_account_user'))]" />
  </record>
</odoo>